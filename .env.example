# GoHighLevel Private Integration token.
# Generate in GHL: Settings -> Private Integrations -> Create -> grant
# "Contacts" write scope. Server-only, never expose with a NEXT_PUBLIC_ prefix.
GHL_API_TOKEN=

# GHL subaccount (location) ID that GHL_API_TOKEN's contacts should land in.
GHL_LOCATION_ID=

# Shows a "scan to visit nettyo.com" QR badge on the hero section (only on
# very large/xl screens, e.g. a conference display). "true" to show it,
# anything else (or unset) hides it.
SHOW_HERO_QR=false
